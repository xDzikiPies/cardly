generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection (przez PgBouncer) — używana w runtime
  directUrl = env("DIRECT_URL") // bezpośrednie połączenie — tylko do migracji (`prisma migrate`)
}

// ---------------------------------------------------------------------------
// User — konto. Bycie "specjalistą" to osobny, świadomy krok (SpecialistProfile),
// NIE dzieje się automatycznie przy rejestracji.
// ---------------------------------------------------------------------------
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cards             BusinessCard[]
  specialistProfile SpecialistProfile?
  reviewsWritten    Review[]           @relation("ReviewAuthor")
  exchangesSent     Exchange[]         @relation("ExchangeFrom")
  exchangesReceived Exchange[]         @relation("ExchangeTo")

  quoteRequestsSent QuoteRequest[]     @relation("QuoteRequester")
  jobListings       JobListing[]       @relation("JobAuthor")
  jobApplications    JobApplication[]  @relation("JobApplicant")
  notifications      Notification[]
  conversations       ConversationParticipant[]
  messagesSent        Message[]
}

// ---------------------------------------------------------------------------
// Wizytówka — użytkownik może mieć kilka, jedna jest "primary" (domyślna do wymiany)
// ---------------------------------------------------------------------------
model BusinessCard {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName   String
  lastName    String
  jobTitle    String
  company     String?
  email       String
  phone       String
  workAddress String?
  logoUrl     String?

  backgroundId String
  background   CardBackground @relation(fields: [backgroundId], references: [id])

  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exchanges Exchange[]

  @@index([userId])
}

// Predefiniowane, gotowe wizualnie tła do wyboru w edytorze
model CardBackground {
  id         String   @id @default(cuid())
  name       String
  colorStart String // hex, np. "#6C5CE7"
  colorEnd   String // hex
  textColor  String // hex, kolor tekstu na tym tle
  pattern    String   @default("none") // "none" | "dots" | "waves" | "grid"
  isPremium  Boolean  @default(false)

  cards BusinessCard[]
}

// ---------------------------------------------------------------------------
// Profil specjalisty — świadomy opt-in, żeby być widocznym na liście
// ---------------------------------------------------------------------------
model SpecialistProfile {
  id         String @id @default(cuid())
  userId     String @unique
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  profession String
  bio        String
  categories String[] // np. ["Prawo", "Nieruchomości"]

  city      String
  latitude  Float
  longitude Float

  ratingAvg   Float @default(0)
  ratingCount Int   @default(0)

  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reviews Review[]

  services ServiceOffering[]
  quoteRequests QuoteRequest[]

  @@index([city])
}

// Konkretna usługa, którą specjalista oferuje, z opcjonalną ceną
// (brak ceny = "Do ustalenia" w UI)
model ServiceOffering {
  id                  String @id @default(cuid())
  specialistProfileId String
  specialistProfile   SpecialistProfile @relation(fields: [specialistProfileId], references: [id], onDelete: Cascade)

  name        String
  description String?
  price       Float? // null = "Do ustalenia"
  priceUnit   String? // np. "godzina", "projekt", "m2" — opcjonalne doprecyzowanie

  createdAt DateTime @default(now())

  @@index([specialistProfileId])
}

model Review {
  id                  String            @id @default(cuid())
  specialistProfileId String
  specialistProfile   SpecialistProfile @relation(fields: [specialistProfileId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("ReviewAuthor", fields: [authorId], references: [id])

  rating  Int // 1-5
  comment String?

  createdAt DateTime @default(now())

  @@index([specialistProfileId])
}

// ---------------------------------------------------------------------------
// Wymiana wizytówek — NFC lub QR
// ---------------------------------------------------------------------------
model Exchange {
  id     String @id @default(cuid())
  method String // "NFC" | "QR"

  fromUserId String
  fromUser   User   @relation("ExchangeFrom", fields: [fromUserId], references: [id])

  toUserId String
  toUser   User   @relation("ExchangeTo", fields: [toUserId], references: [id])

  cardId String
  card   BusinessCard @relation(fields: [cardId], references: [id])

  createdAt DateTime @default(now())

  @@index([fromUserId])
  @@index([toUserId])
}

// ---------------------------------------------------------------------------
// "Zapytaj o wycenę" — zapytanie kierowane do konkretnego specjalisty
// ---------------------------------------------------------------------------
model QuoteRequest {
  id                  String @id @default(cuid())
  specialistProfileId String
  specialistProfile   SpecialistProfile @relation(fields: [specialistProfileId], references: [id], onDelete: Cascade)

  requesterId String
  requester   User   @relation("QuoteRequester", fields: [requesterId], references: [id])

  title       String
  description String
  budget      Float? // null = brak podanego budżetu

  status String @default("pending") // pending | accepted | declined

  attachments QuoteRequestAttachment[]

  conversationId String?       @unique
  conversation   Conversation? @relation(fields: [conversationId], references: [id])

  createdAt DateTime @default(now())

  @@index([specialistProfileId])
  @@index([requesterId])
}

model QuoteRequestAttachment {
  id             String       @id @default(cuid())
  quoteRequestId String
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  url            String
}

// ---------------------------------------------------------------------------
// Rynek zleceń — użytkownicy wystawiają zlecenia, inni się zgłaszają
// ---------------------------------------------------------------------------
model JobListing {
  id       String @id @default(cuid())
  authorId String
  author   User   @relation("JobAuthor", fields: [authorId], references: [id])

  title       String
  description String
  category    String

  budget     Float?
  budgetType String @default("negotiable") // fixed | hourly | negotiable

  city      String
  latitude  Float
  longitude Float

  deadline DateTime?
  status   String    @default("open") // open | in_progress | closed

  createdAt DateTime @default(now())

  applications JobApplication[]

  @@index([category])
  @@index([city])
  @@index([status])
}

model JobApplication {
  id           String     @id @default(cuid())
  jobListingId String
  jobListing   JobListing @relation(fields: [jobListingId], references: [id], onDelete: Cascade)

  applicantId String
  applicant   User   @relation("JobApplicant", fields: [applicantId], references: [id])

  message String?
  price   Float?
  status  String  @default("pending") // pending | accepted | rejected

  conversationId String?       @unique
  conversation   Conversation? @relation(fields: [conversationId], references: [id])

  createdAt DateTime @default(now())

  @@index([jobListingId])
  @@index([applicantId])
}

// ---------------------------------------------------------------------------
// Powiadomienia
// ---------------------------------------------------------------------------
model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type   String // "quote_request" | "quote_status" | "job_application" | "message" | "review"
  title  String
  body   String
  isRead Boolean @default(false)
  data   Json? // dowolny dodatkowy payload, np. { "conversationId": "..." }

  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

// ---------------------------------------------------------------------------
// Czat — jedna konwersacja na zapytanie o wycenę albo na zgłoszenie do zlecenia
// ---------------------------------------------------------------------------
model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  participants   ConversationParticipant[]
  messages       Message[]
  quoteRequest   QuoteRequest?
  jobApplication JobApplication?
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  lastReadAt DateTime?

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation(fields: [senderId], references: [id])

  text      String
  createdAt DateTime @default(now())

  @@index([conversationId])
}
