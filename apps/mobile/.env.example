# Adres backendu (apps/web). Na fizycznym telefonie/dev-buildzie "localhost" NIE zadziała —
# użyj adresu IP swojego komputera w tej samej sieci Wi-Fi, np:
# EXPO_PUBLIC_API_URL=http://192.168.1.23:3000/api
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Domena, pod którą wdrożysz apps/web — używana do generowania linków do wizytówek (QR/NFC)
EXPO_PUBLIC_WEB_URL=http://localhost:3000
