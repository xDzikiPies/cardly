{
  "expo": {
    "name": "Cardly",
    "slug": "cardly",
    "scheme": "cardly",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-camera",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#5B4CF0"
        }
      ],
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "Cardly używa NFC do wymiany wizytówek między telefonami.",
          "includeNdefEntitlement": false
        }
      ],
      "./plugins/withNfcHce.js",
      "expo-font",
      "expo-secure-store"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.szymonwitek.cardly",
      "buildNumber": "20",
      "infoPlist": {
        "NFCReaderUsageDescription": "Cardly używa NFC do wymiany wizytówek między telefonami.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.szymonwitek.cardly",
      "permissions": [
        "android.permission.NFC",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "354481c9-6b81-43fd-b288-e305b064e3d8"
      }
    }
  }
}