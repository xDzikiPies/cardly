{
  "expo": {
    "name": "Cardly",
    "slug": "cardly",
    "scheme": "cardly",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-camera",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#5B4CF0"
        }
      ],
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "Cardly używa NFC do wymiany wizytówek między telefonami."
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.szymonwitek.cardly",
      "infoPlist": {
        "NFCReaderUsageDescription": "Cardly używa NFC do wymiany wizytówek między telefonami."
      }
    },
    "android": {
      "package": "com.szymonwitek.cardly",
      "permissions": ["android.permission.NFC", "android.permission.CAMERA"]
    }
  }
}
